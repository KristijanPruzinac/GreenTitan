<launch>
  <!-- Drive page (web_ui) on http://<host>:ui_port/ -->
  <arg name="ui" default="true"/>
  <arg name="ui_port" default="8080"/>

  <!-- Static transforms (IMU and GPS links relative to base_link) -->
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="base_link_to_imu"
        args="0 0 0 0 0 0 base_link imu_link"/>
  <node pkg="tf2_ros" exec="static_transform_publisher"
        name="base_link_to_gps"
        args="0 0 0 0 0 0 base_link gps_link"/>

  <!-- Single EKF fusing GPS odometry and IMU -->
  <node pkg="robot_localization" exec="ekf_node"
        name="ekf" output="screen">
    <param from="$(find-pkg-share robot_package)/config/ekf.yaml"/>
    <remap from="/odometry/filtered" to="/odometry/filtered/global"/>
  </node>

  <!-- The EKF pose for the ESP32, compact (the 724-byte Odometry broke the micro-ROS link) -->
  <node pkg="robot_package" exec="fused_pose_relay" name="fused_pose_relay" output="screen"/>

  <!-- Your custom nodes (path_visualizer) -->
  <node pkg="robot_package" exec="path_visualizer" name="path_visualizer" output="screen"/>

  <!-- Joystick and live top-down view in a browser (phone or PC) -->
  <node pkg="robot_package" exec="web_ui" name="web_ui" output="screen" if="$(var ui)">
    <param name="port" value="$(var ui_port)"/>
  </node>
</launch>
